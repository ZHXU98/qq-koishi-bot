# QQ 登录态（包含敏感 session，勿提交）
napcat/QQ/
napcat/QQ_config/

# 环境变量（包含 QQ 账号）
.env

.codeflicker

# ===== ths-news 服务 =====
# 中文字体（22MB+ 且涉及字体授权，不入库；用 setup_fonts.sh 从本机系统复制）
ths-news/fonts/*.ttc
ths-news/fonts/*.ttf
ths-news/fonts/*.otf
# 真实推送目标（含真实 QQ 号，勿提交；用 .example 模板）
ths-news/ths_news_targets.json
# 运行日志
ths-news/*.log
*.log

# NapCat 配置（含 OneBot token / 登录票据，敏感，勿提交）
napcat/config/

# macOS 垃圾文件
.DS_Store
**/.DS_Store

# 备份文件（如 docker-compose.yml.bak）
*.bak

# ===== A股 复盘推送（宿主运行，非容器） =====
# 真实推送目标（含真实 QQ 号，勿提交；用 push_targets.json.example 模板）
a-share-report/push_targets.json
# 渲染产物与本地日志
a-share-report/*.png
a-share-report/*.log

# ===== qq-reply 被@回复服务（容器） =====
# 运行配置（可含自定义欢迎语/管理员列表，勿提交；用 config.json.example 模板）
reply/config.json

# ===== NapCat 掉线监控（宿主运行，非容器） =====
# 运行态产物：状态记录、日志、二维码、远程扫码预览页（含 QQ 登录票据信息，勿提交）
monitor/state.json
monitor/monitor.log
monitor/latest_qr*.png
monitor/napcat_qr.html
monitor/qr_view.html
# 掉线事件记录（运行态产物，自动维护，勿提交）
monitor/disconnect_log.md
monitor/.disconnect_state
# NapCat 监控 skill 打包产物（构建产物，非源码）
.workbuddy/skills/napcat-monitor/napcat-monitor.zip
