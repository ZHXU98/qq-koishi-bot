# QQ 登录态（包含敏感 session，勿提交）
napcat/QQ/
napcat/QQ_config/

# 环境变量（包含 QQ 账号）
.env

.codeflicker

# ===== ths-news 服务 =====
# 中文字体：cjk.ttc（WQY 微米黑，开源，~5MB）随项目入库，其余字体文件不入库
ths-news/fonts/*.ttf
ths-news/fonts/*.otf
# cjk.ttc 允许入库（!例外规则必须在通配符之后声明）
!ths-news/fonts/cjk.ttc
# 真实推送目标（含真实 QQ 号，勿提交；用 .example 模板）
ths-news/ths_news_targets.json
# 运行日志
ths-news/*.log
*.log
# 日志清理脚本的输出目录
logs/

# NapCat 配置（含 OneBot token / 登录票据，敏感，勿提交）
napcat/config/

# macOS 垃圾文件
.DS_Store
**/.DS_Store

# 备份文件（如 docker-compose.yml.bak）
*.bak

# ===== A股 复盘推送（宿主运行，非容器） =====
# 真实推送目标（含真实 QQ 号，勿提交；用 push_targets.json.example 模板）
a-share-report/push_targets.json
# 渲染产物与本地日志
a-share-report/*.png
a-share-report/*.log

# ===== qq-reply 被@回复服务（容器） =====
# 运行配置（可含自定义欢迎语/管理员列表，勿提交；用 config.json.example 模板）
reply/config.json
reply/data

# /stocks 组合数据（运行态产物，含个人持仓组合，勿提交；用 portfolios.json.example 模板）
reply/data/portfolios.json
reply/data/portfolios.json.tmp
# 群友个人看板（-my）：按 uid 存的自选，同样属于运行态隐私数据
reply/data/myboards.json
reply/data/myboards.json.tmp

# ===== 2026-08-19 新增 =====
# 备份文件（如 docker-compose.yml.bak-qrflow）
*.bak-*

# WorkBuddy 会话自动产物（自动化备份/记忆，非本项目源码）
.workbuddy/

# 设备指纹固定值（敏感设备标识，勿提交；用 machine-id.example 模板）
napcat/machine-id

# ===== official-bot-gateway =====
official-bot-gateway/node_modules/
official-bot-gateway/bindings.json
official-bot-gateway/daily-state.json

# ===== 开发中间产物（2026-09-11 新增：防止再次误提交） =====
# NapCat 登录二维码（含登录票据信息，敏感，勿提交）
napcat/qrcode*.png
# 报告产物（每次自动生成的 HTML）
a-share-report/reports/

# ===== 依赖目录（各服务各自 install，不入库） =====
node_modules/
# 例外：ECharts 本地库随项目入库，供离线渲染报告用
!a-share-report/vendor/
!a-share-report/vendor/echarts.min.js
