# 复制本文件为 .env 并填入凭证
# .env 已 gitignore，切勿提交或外传

# ========== 官方 QQ 机器人（必填） ==========
# 获取位置：q.qq.com → 你的机器人 → 开发配置
QQBOT_APP_ID=你的AppID
QQBOT_APP_SECRET=你的AppSecret

# ========== NapCat 备用通道（默认未启动，需要时填写） ==========
# 见 README「NapCat 备用通道（默认未启动）」章节；官方通道下无需填写
# QQ_ACCOUNT=你的小号QQ
# QQ_QUICK_PASSWORD=
